# ─────────────────────────────────────────────────────────────
# HoraUtil API — variáveis de ambiente (NÃO versionar o .env real)
# Copie para `.env` e ajuste. NF-S09: zero segredos no repositório.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# PostgreSQL (BR: Drizzle ORM, parâmetros preparados — nunca concatenar SQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/horautil
DB_POOL_MAX=10

# Segredo de assinatura do access token (HS256). Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-longo
JWT_ACCESS_TTL=15m

# Segredo do HMAC usado para hashear refresh tokens e tokens de reset (SHA-256 + HMAC)
REFRESH_TOKEN_PEPPER=troque-este-valor-por-um-outro-segredo-aleatorio
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Allowlist explícita de origens (NF-S08). Separadas por vírgula.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Nome do cookie HttpOnly que carrega o refresh token (NF-S13)
REFRESH_COOKIE_NAME=horautil_rt

# Token estático para os jobs internos (POST /v1/internal/jobs/*).
# Se vazio, os jobs internos ficam desabilitados (fail-closed).
INTERNAL_JOB_TOKEN=

# Documentação OpenAPI (DoD 10.3) — desabilite em produção se preferir
ENABLE_SWAGGER=true

# Segredos de observabilidade (NF-O02). Opcional em desenvolvimento.
SENTRY_DSN=

# Server
PORT=3333
HOST=0.0.0.0
NODE_ENV=production

# Database
DATABASE_URL=postgres://horautil:horautil@postgres:5432/horautil
POSTGRES_USER=horautil
POSTGRES_PASSWORD=horautil
POSTGRES_DB=horautil

# Auth
JWT_SECRET=change-me-32-bytes-min
JWT_ACCESS_TTL=900
REFRESH_TOKEN_SECRET=change-me-32-bytes-min
REFRESH_TOKEN_TTL=2592000
REFRESH_TOKEN_COOKIE_NAME=rt
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=strict

# CORS (ajuste para seu front)
CORS_ALLOWLIST=http://localhost:3000,http://localhost:8081,http://localhost:5173

# Rate limit
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Pepper for refresh tokens (opcional mas recomendado)
REFRESH_TOKEN_PEPPER=change-me-pepper